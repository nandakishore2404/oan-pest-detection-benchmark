# ==============================================================================
# OAN Kenya Pest Detection Lab - Environment Configuration
# ==============================================================================

# Execution Device: 'auto', 'cuda', or 'cpu'
OAN_DEVICE=auto

# Default Safety Confidence Abstention Threshold (0.0 to 1.0)
OAN_ABSTENTION_THRESHOLD=0.40

# Local Model Weights Directory
OAN_WEIGHTS_DIR=./models/weights

# Golden Benchmark Dataset Path
OAN_DATASET_PATH=./data/golden/dataset.csv

# Output Directory for Normalized Predictions & Reports
OAN_OUTPUT_DIR=./results/normalized

# Optional Frontier API Keys (Used only if benchmarking commercial ceiling models)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Beckn ONIX Integration (Milestone 3 Readiness)
BPP_ADAPTER_URL=http://localhost:8081
OAN_PROVIDER_ID=oan-crop-protection-ke-01
